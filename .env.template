# Copy to .env and adjust for local development:
#   cp .env.template .env
#
# pydantic-settings reads these variables (see app/config.py).
# Docker Compose sets DATABASE_URL and REDIS_URL for api/worker services.

# PostgreSQL connection string (SQLModel / psycopg)
DATABASE_URL=postgresql+psycopg://events:events@localhost:5432/events

# Redis connection string (queue)
REDIS_URL=redis://localhost:6379/0

# Redis Stream name for transaction events
STREAM_NAME=transactions

# Redis consumer group used by the worker
CONSUMER_GROUP=processors

# Consumer name within the group (unique per worker instance)
CONSUMER_NAME=worker-1

# Base URL for FX rate lookup API
FX_API_BASE_URL=https://api.frankfurter.dev/v1

# How long to reuse a fetched FX rate before calling Frankfurter again
FX_RATE_CACHE_TTL_SECONDS=3600

# Copy to .env and adjust for local development:
#   cp .env.template .env
#
# pydantic-settings reads these variables (see app/config.py).
# Docker Compose loads this file for all services (env_file).
# api/worker get POSTGRES_HOST=postgres and REDIS_HOST=redis from compose overrides.

# --- PostgreSQL ---
POSTGRES_USER=events
POSTGRES_PASSWORD=events
POSTGRES_DB=events
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# --- API ---
API_PORT=8000

# --- Application (api + worker) ---
STREAM_NAME=transactions
CONSUMER_GROUP=processors
CONSUMER_NAME=worker-1
FX_API_BASE_URL=https://api.frankfurter.dev/v1
FX_RATE_CACHE_TTL_SECONDS=3600
